{
  "id": "stm-ai-assistant",
  "name": "AI 角色卡分析助手",
  "version": "0.4.1",
  "api_version": 3,
  "manifest_version": 3,
  "author": "ST-Manager",
  "description": "角色卡的 AI 工作台：打标（概览与标签）、世界书精简、自动归类、分类体系提议；批量作业、逐条审批与成本记账。",
  "license": "Apache-2.0",
  "min_app_version": "1.1.0",
  "backend": {
    "entry": "backend",
    "register": "register",
    "jobs": [
      "ai.analyze",
      "ai.wi_rewrite",
      "ai.classify",
      "ai.propose",
      "ai.agent"
    ],
    "hooks": []
  },
  "frontend": {
    "entry": "frontend/plugin.js",
    "styles": [
      "frontend/plugin.css"
    ],
    "render_mode": "declarative",
    "contributions": {
      "menus": [
        {
          "id": "workbench",
          "placement": "dock",
          "type": "item",
          "label": "AI 助手",
          "description": "任务中心：打标、世界书精简、自动归类、分类体系提议。",
          "icon": "frontend/assets/icon.svg",
          "order": 40,
          "action": {
            "type": "command",
            "id": "open-workbench"
          }
        },
        {
          "id": "ai-helper-context",
          "placement": "context.folder",
          "type": "submenu",
          "label": "AI 助手",
          "description": "右键分类可用的 AI 任务",
          "icon": "frontend/assets/icon.svg",
          "order": 55,
          "children": [
            {
              "id": "analyze-folder",
              "type": "item",
              "label": "AI 打标此分类全部卡片",
              "description": "为该分类（含子分类）下的卡片生成概览与标签建议。",
              "icon": "frontend/assets/icon.svg",
              "order": 10,
              "when": {
                "mode": [
                  "cards"
                ]
              },
              "disabledHint": "仅支持右键分类；请在角色卡视图里右键一个分类",
              "action": {
                "type": "surface",
                "id": "analyze"
              }
            },
            {
              "id": "classify-folder",
              "type": "item",
              "label": "AI 归类此分类全部卡片",
              "description": "判断该分类下的卡片应放在哪个分类，并移动目录。",
              "icon": "frontend/assets/icon.svg",
              "order": 20,
              "when": {
                "mode": [
                  "cards"
                ]
              },
              "disabledHint": "仅支持右键分类；请在角色卡视图里右键一个分类",
              "action": {
                "type": "surface",
                "id": "classify"
              }
            },
            {
              "id": "polish-embedded",
              "type": "item",
              "label": "AI 精简这些卡片的嵌入世界书",
              "description": "对卡片内嵌世界书的条目做压缩改写，逐条确认后写回。",
              "icon": "frontend/assets/icon.svg",
              "order": 30,
              "when": {
                "mode": [
                  "cards"
                ]
              },
              "disabledHint": "仅支持右键分类；请在角色卡视图里右键一个分类",
              "action": {
                "type": "surface",
                "id": "polish"
              }
            },
            {
              "id": "polish-folder",
              "type": "item",
              "label": "AI 精简此分类世界书",
              "description": "对该分类下的世界书条目做压缩改写，逐条确认后写回。",
              "icon": "frontend/assets/icon.svg",
              "order": 40,
              "when": {
                "mode": [
                  "worldinfo"
                ]
              },
              "disabledHint": "仅支持右键分类；请在世界书视图里右键一个分类",
              "action": {
                "type": "surface",
                "id": "polish"
              }
            }
          ]
        },
        {
          "id": "ai-helper-batch",
          "placement": "batch.actions",
          "type": "submenu",
          "label": "AI 助手",
          "description": "对批量选中的卡片 / 世界书执行 AI 任务",
          "icon": "frontend/assets/icon.svg",
          "order": 60,
          "children": [
            {
              "id": "analyze-selected",
              "type": "item",
              "label": "AI 打标选中卡片",
              "description": "为批量操作里选中的卡片生成概览与标签建议。",
              "icon": "frontend/assets/icon.svg",
              "order": 10,
              "when": {
                "mode": [
                  "cards"
                ],
                "selection": "any"
              },
              "disabledHint": "请先在角色卡视图里选中至少一张卡片",
              "action": {
                "type": "surface",
                "id": "analyze"
              }
            },
            {
              "id": "classify-selected",
              "type": "item",
              "label": "AI 归类选中卡片",
              "description": "判断选中卡片应放在哪个分类，并移动目录。",
              "icon": "frontend/assets/icon.svg",
              "order": 20,
              "when": {
                "mode": [
                  "cards"
                ],
                "selection": "any"
              },
              "disabledHint": "请先在角色卡视图里选中至少一张卡片",
              "action": {
                "type": "surface",
                "id": "classify"
              }
            },
            {
              "id": "polish-selector",
              "type": "item",
              "label": "AI 精简选中世界书",
              "description": "对选中的世界书条目做压缩改写，逐条确认后写回。",
              "icon": "frontend/assets/icon.svg",
              "order": 30,
              "when": {
                "mode": [
                  "worldinfo"
                ],
                "selection": "any"
              },
              "disabledHint": "请先在世界书视图里选中至少一本世界书",
              "action": {
                "type": "surface",
                "id": "polish"
              }
            }
          ]
        },
        {
          "id": "open-review",
          "placement": "commandPalette",
          "type": "item",
          "label": "AI 结果与审批",
          "description": "查看 AI 作业结果，逐条确认后写入卡片或世界书。",
          "icon": "frontend/assets/icon.svg",
          "order": 45,
          "action": {
            "type": "command",
            "id": "open-review"
          }
        },
        {
          "id": "propose-library",
          "placement": "commandPalette",
          "type": "item",
          "label": "AI 设计分类体系",
          "description": "分析整个卡片库，提出分类方案与标签池；只创建结构，不动卡片。",
          "icon": "frontend/assets/icon.svg",
          "order": 46,
          "action": {
            "type": "command",
            "id": "propose-library"
          }
        },
        {
          "id": "open-profiles",
          "placement": "commandPalette",
          "type": "item",
          "label": "AI 提示词档案",
          "description": "按任务分组管理提示词档案：模板、破限段、格式与字数规则。",
          "icon": "frontend/assets/icon.svg",
          "order": 47,
          "action": {
            "type": "command",
            "id": "open-profiles"
          }
        },
        {
          "id": "assistant-settings",
          "placement": "settings.nav",
          "type": "item",
          "label": "AI 助手设置",
          "description": "Provider、密钥、用量与新标签建议。",
          "icon": "frontend/assets/icon.svg",
          "order": 80,
          "action": {
            "type": "surface",
            "id": "settings"
          }
        }
      ],
      "slots": [],
      "commands": [
        {
          "id": "open-workbench",
          "title": "AI 助手：打开任务中心",
          "description": "打开 AI 助手任务中心（hub）。",
          "icon": "frontend/assets/icon.svg",
          "shortcut": "Ctrl+Shift+A",
          "module": "frontend/commands.js",
          "export": "openWorkbench"
        },
        {
          "id": "open-review",
          "title": "AI 结果与审批",
          "description": "查看 AI 作业结果，逐条确认后写入卡片或世界书。",
          "icon": "frontend/assets/icon.svg",
          "module": "frontend/commands.js",
          "export": "openReview"
        },
        {
          "id": "propose-library",
          "title": "AI 设计分类体系",
          "description": "分析整个卡片库，提出分类方案与标签池；只创建结构，不动卡片。",
          "icon": "frontend/assets/icon.svg",
          "module": "frontend/commands.js",
          "export": "proposeLibrary"
        },
        {
          "id": "open-profiles",
          "title": "AI 提示词档案",
          "description": "按任务分组管理提示词档案：模板、破限段、格式与字数规则。",
          "icon": "frontend/assets/icon.svg",
          "module": "frontend/commands.js",
          "export": "openProfiles"
        }
      ]
    }
  },
  "capabilities": [
    "cards.read",
    "cards.write",
    "worldbook.read",
    "worldbook.write",
    "tags.read",
    "tags.write",
    "secrets.read",
    "network.outbound",
    "jobs.run"
  ],
  "config_schema": {
    "type": "object",
    "properties": {
      "default_profile_id": {
        "type": "string",
        "title": "默认提示词档案",
        "description": "未显式指定时使用的档案 id；留空表示按模型自动匹配。",
        "default": ""
      },
      "max_tags": {
        "type": "integer",
        "title": "最大标签数（总上限）",
        "description": "一次分析最多打多少个标签。各分类的「设置数量」之和不能超过它；没单独设置的分类只受这个总上限约束。",
        "default": 8,
        "minimum": 1,
        "maximum": 20
      },
      "summary_max_chars": {
        "type": "integer",
        "title": "概览字数上限",
        "default": 300,
        "minimum": 50,
        "maximum": 2000
      },
      "batch_size": {
        "type": "integer",
        "title": "每批张数",
        "default": 5,
        "minimum": 1,
        "maximum": 50
      },
      "concurrency": {
        "type": "integer",
        "title": "并发数",
        "description": "同一作业内的 LLM 并发请求数；过大易触发供应商限流。",
        "default": 1,
        "minimum": 1,
        "maximum": 8
      },
      "apply_mode": {
        "type": "enum",
        "title": "写回方式",
        "description": "auto：生成后直接写入；review：逐条人工确认后再应用。",
        "enum": [
          "auto",
          "review"
        ],
        "default": "review"
      },
      "apply_tags": {
        "type": "boolean",
        "title": "自动写入标签",
        "default": true
      },
      "skip_unchanged": {
        "type": "boolean",
        "title": "跳过内容未变化的卡片",
        "default": true
      },
      "validation_strict": {
        "type": "boolean",
        "title": "严格校验",
        "description": "开启后，输出未通过格式/字数校验的条目直接判失败，不做挽救。",
        "default": false
      },
      "wi_excerpt_ratio": {
        "type": "number",
        "title": "世界书节选预算占比",
        "default": 0.3,
        "minimum": 0,
        "maximum": 1
      },
      "wi_keywords": {
        "type": "string",
        "title": "世界书高价值关键词",
        "description": "逗号分隔；条目名命中这些词的 content 优先进入提示词。",
        "default": "世界观,设定,背景,叙事要求,元数据,规则"
      },
      "tag_pool_categories_include": {
        "type": "string",
        "title": "标签池：只取这些分类",
        "description": "按标签分类限制 AI 能看到的标签，逗号分隔（例：人设，关系）。留空 = 不限制。分类名要与标签库里的一致；带 ? 说明和分类按钮的图形化设置在「AI 助手设置 → 标签池」。",
        "default": ""
      },
      "tag_pool_categories_exclude": {
        "type": "string",
        "title": "标签池：排除这些分类",
        "description": "这些分类下的标签不会给 AI 看、也不会被建议删除（冻结），逗号分隔（例：成人，血腥）。留空 = 不排除。",
        "default": ""
      },
      "tag_category_rules": {
        "type": "string",
        "title": "标签池：每个分类的置信度与数量（JSON）",
        "description": "格式：{\"分类\": {\"confidence_min\": 0.6, \"max_tags\": 3}}。由插件设置页「AI 助手设置 → 标签池」维护，一般不用手填；各分类 max_tags 之和不能超过最大标签数。",
        "default": ""
      },
      "tag_pool_budget_tokens": {
        "type": "integer",
        "title": "标签池 token 预算",
        "description": "给 AI 列出标签库时最多花多少 token（默认 1200，约 60–100 个标签）。调大能让模型看到更多已有标签、减少「把已有标签当新标签」；代价是每次分析 prompt 更长、更贵。会被模型上下文上限夹住。",
        "default": 1200,
        "minimum": 200,
        "maximum": 20000
      },
      "context_length": {
        "type": "integer",
        "title": "上下文长度（token）",
        "description": "模型的上下文窗口。用于 Agent 上下文预算与请求预算上限；默认 256K。",
        "default": 262144,
        "minimum": 8192,
        "maximum": 4000000
      },
      "max_output_tokens": {
        "type": "integer",
        "title": "输出长度上限（token）",
        "description": "单次调用的最大输出。档案里把 max_tokens 设为 0 即跟随此值；默认 32K。",
        "default": 32768,
        "minimum": 256,
        "maximum": 262144
      },
      "reasoning_enabled": {
        "type": "boolean",
        "title": "启用推理（思考）",
        "description": "关闭后请求里带 reasoning_effort=none（仅 OpenAI 风格协议）。",
        "default": true
      },
      "reasoning_effort": {
        "type": "enum",
        "title": "思考等级",
        "description": "auto 表示不显式传，用供应商默认；仅在启用推理时生效。",
        "enum": ["auto", "low", "medium", "high"],
        "default": "auto"
      },
      "price_per_1k_prompt": {
        "type": "number",
        "title": "每千 prompt token 单价",
        "description": "用于成本预估，留 0 表示不估算金额。",
        "default": 0
      },
      "price_per_1k_completion": {
        "type": "number",
        "title": "每千 completion token 单价",
        "default": 0
      },
      "currency": {
        "type": "string",
        "title": "计价货币符号",
        "default": "CNY"
      }
    }
  },
  "secret_schema": {
    "type": "object",
    "properties": {
      "api_key": {
        "type": "string",
        "title": "默认 Provider 的 API Key",
        "description": "这是「回退密钥」：仅当默认 Provider 没有自己的专属密钥时生效；在插件设置页为某个 Provider 单独填写的密钥会覆盖它。地址与模型请到插件的 Provider 页配置。",
        "secret": true
      }
    }
  }
}
