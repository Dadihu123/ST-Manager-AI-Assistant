{
  "id": "stm-ai-assistant",
  "name": "AI 角色卡分析助手",
  "version": "0.2.0",
  "api_version": 2,
  "manifest_version": 2,
  "author": "ST-Manager",
  "description": "角色卡的 AI 工作台：打标（概览与标签）、世界书精简、自动归类、分类体系提议；批量作业、逐条审批与成本记账。",
  "license": "MIT",
  "min_app_version": "1.0.0",
  "backend": {
    "entry": "backend",
    "register": "register",
    "jobs": [
      "ai.analyze",
      "ai.wi_rewrite",
      "ai.classify",
      "ai.propose",
      "ai.agent"
    ],
    "hooks": []
  },
  "frontend": {
    "entry": "frontend/plugin.js",
    "styles": [
      "frontend/plugin.css"
    ],
    "entries": [
      {
        "id": "workbench",
        "kind": "dock",
        "label": "AI 助手",
        "description": "任务中心：打标、世界书精简、自动归类、分类体系提议。",
        "icon": "frontend/assets/icon.svg",
        "surface": {
          "id": "hub",
          "type": "modal"
        },
        "shortcut": "Ctrl+Shift+A",
        "priority": 40
      },
      {
        "id": "analyze-folder",
        "kind": "context",
        "label": "AI 打标此分类全部卡片",
        "group": "AI 助手",
        "description": "为该分类（含子分类）下的卡片生成概览与标签建议。",
        "icon": "frontend/assets/icon.svg",
        "surface": {
          "id": "analyze",
          "type": "modal"
        },
        "when": {
          "mode": [
            "cards"
          ],
          "target": "folder"
        },
        "disabledHint": "仅支持右键分类；请在角色卡视图里右键一个分类",
        "priority": 55
      },
      {
        "id": "analyze-selected",
        "kind": "batch",
        "label": "AI 打标选中卡片",
        "group": "AI 助手",
        "description": "为批量操作里选中的卡片生成概览与标签建议。",
        "icon": "frontend/assets/icon.svg",
        "surface": {
          "id": "analyze",
          "type": "modal"
        },
        "requires_selection": true,
        "when": {
          "mode": [
            "cards"
          ],
          "selection": "any"
        },
        "disabledHint": "请先在角色卡视图里选中至少一张卡片",
        "priority": 60
      },
      {
        "id": "classify-folder",
        "kind": "context",
        "label": "AI 归类此分类全部卡片",
        "group": "AI 助手",
        "description": "判断该分类下的卡片应放在哪个分类，并移动目录。",
        "icon": "frontend/assets/icon.svg",
        "surface": {
          "id": "classify",
          "type": "modal"
        },
        "when": {
          "mode": [
            "cards"
          ],
          "target": "folder"
        },
        "disabledHint": "仅支持右键分类；请在角色卡视图里右键一个分类",
        "priority": 56
      },
      {
        "id": "classify-selected",
        "kind": "batch",
        "label": "AI 归类选中卡片",
        "group": "AI 助手",
        "description": "判断选中卡片应放在哪个分类，并移动目录。",
        "icon": "frontend/assets/icon.svg",
        "surface": {
          "id": "classify",
          "type": "modal"
        },
        "requires_selection": true,
        "when": {
          "mode": [
            "cards"
          ],
          "selection": "any"
        },
        "disabledHint": "请先在角色卡视图里选中至少一张卡片",
        "priority": 61
      },
      {
        "id": "polish-embedded",
        "kind": "context",
        "label": "AI 精简这些卡片的嵌入世界书",
        "group": "AI 助手",
        "description": "对卡片内嵌世界书的条目做压缩改写，逐条确认后写回。",
        "icon": "frontend/assets/icon.svg",
        "surface": {
          "id": "polish",
          "type": "modal"
        },
        "when": {
          "mode": [
            "cards"
          ],
          "target": "folder"
        },
        "disabledHint": "仅支持右键分类；请在角色卡视图里右键一个分类",
        "priority": 57
      },
      {
        "id": "polish-selector",
        "kind": "batch",
        "label": "AI 精简选中世界书",
        "group": "AI 助手",
        "description": "对选中的世界书条目做压缩改写，逐条确认后写回。",
        "icon": "frontend/assets/icon.svg",
        "surface": {
          "id": "polish",
          "type": "modal"
        },
        "requires_selection": true,
        "when": {
          "mode": [
            "worldinfo"
          ],
          "selection": "any"
        },
        "disabledHint": "请先在世界书视图里选中至少一本世界书",
        "priority": 62
      },
      {
        "id": "polish-folder",
        "kind": "context",
        "label": "AI 精简此分类世界书",
        "group": "AI 助手",
        "description": "对该分类下的世界书条目做压缩改写，逐条确认后写回。",
        "icon": "frontend/assets/icon.svg",
        "surface": {
          "id": "polish",
          "type": "modal"
        },
        "when": {
          "mode": [
            "worldinfo"
          ],
          "target": "folder"
        },
        "disabledHint": "仅支持右键分类；请在世界书视图里右键一个分类",
        "priority": 58
      },
      {
        "id": "open-review",
        "kind": "command",
        "label": "AI 结果与审批",
        "description": "查看 AI 作业结果，逐条确认后写入卡片或世界书。",
        "icon": "frontend/assets/icon.svg",
        "surface": {
          "id": "review",
          "type": "modal"
        },
        "priority": 45
      },
      {
        "id": "propose-library",
        "kind": "command",
        "label": "AI 设计分类体系",
        "description": "分析整个卡片库，提出分类方案与标签池；只创建结构，不动卡片。",
        "icon": "frontend/assets/icon.svg",
        "surface": {
          "id": "propose",
          "type": "modal"
        },
        "priority": 46
      },
      {
        "id": "open-profiles",
        "kind": "command",
        "label": "AI 提示词档案",
        "description": "按任务分组管理提示词档案：模板、破限段、格式与字数规则。",
        "icon": "frontend/assets/icon.svg",
        "surface": {
          "id": "profiles",
          "type": "modal"
        },
        "priority": 47
      },
      {
        "id": "assistant-settings",
        "kind": "settings",
        "label": "AI 助手设置",
        "description": "Provider、密钥、用量与新标签建议。",
        "icon": "frontend/assets/icon.svg",
        "surface": {
          "id": "settings",
          "type": "modal"
        },
        "priority": 80
      }
    ]
  },
  "permissions": [
    "cards.read",
    "cards.write",
    "worldbook.read",
    "worldbook.write",
    "tags.read",
    "tags.write",
    "secrets.read",
    "network.outbound",
    "jobs.run"
  ],
  "config_schema": {
    "type": "object",
    "properties": {
      "default_profile_id": {
        "type": "string",
        "title": "默认提示词档案",
        "description": "未显式指定时使用的档案 id；留空表示按模型自动匹配。",
        "default": ""
      },
      "max_tags": {
        "type": "integer",
        "title": "最大标签数",
        "default": 8,
        "minimum": 1,
        "maximum": 20
      },
      "summary_max_chars": {
        "type": "integer",
        "title": "概览字数上限",
        "default": 300,
        "minimum": 50,
        "maximum": 2000
      },
      "confidence_min": {
        "type": "number",
        "title": "标签置信度下限",
        "default": 0.5,
        "minimum": 0,
        "maximum": 1
      },
      "batch_size": {
        "type": "integer",
        "title": "每批张数",
        "default": 5,
        "minimum": 1,
        "maximum": 50
      },
      "concurrency": {
        "type": "integer",
        "title": "并发数",
        "description": "同一作业内的 LLM 并发请求数；过大易触发供应商限流。",
        "default": 1,
        "minimum": 1,
        "maximum": 8
      },
      "apply_mode": {
        "type": "enum",
        "title": "写回方式",
        "description": "auto：生成后直接写入；review：逐条人工确认后再应用。",
        "enum": [
          "auto",
          "review"
        ],
        "default": "review"
      },
      "apply_tags": {
        "type": "boolean",
        "title": "自动写入标签",
        "default": true
      },
      "skip_unchanged": {
        "type": "boolean",
        "title": "跳过内容未变化的卡片",
        "default": true
      },
      "validation_strict": {
        "type": "boolean",
        "title": "严格校验",
        "description": "开启后，输出未通过格式/字数校验的条目直接判失败，不做挽救。",
        "default": false
      },
      "wi_excerpt_ratio": {
        "type": "number",
        "title": "世界书节选预算占比",
        "default": 0.3,
        "minimum": 0,
        "maximum": 1
      },
      "wi_keywords": {
        "type": "string",
        "title": "世界书高价值关键词",
        "description": "逗号分隔；条目名命中这些词的 content 优先进入提示词。",
        "default": "世界观,设定,背景,叙事要求,元数据,规则"
      },
      "price_per_1k_prompt": {
        "type": "number",
        "title": "每千 prompt token 单价",
        "description": "用于成本预估，留 0 表示不估算金额。",
        "default": 0
      },
      "price_per_1k_completion": {
        "type": "number",
        "title": "每千 completion token 单价",
        "default": 0
      },
      "currency": {
        "type": "string",
        "title": "计价货币符号",
        "default": "CNY"
      }
    }
  },
  "secret_schema": {
    "type": "object",
    "properties": {
      "api_key": {
        "type": "string",
        "title": "默认 Provider 的 API Key",
        "description": "这是「回退密钥」：仅当默认 Provider 没有自己的专属密钥时生效；在插件设置页为某个 Provider 单独填写的密钥会覆盖它。地址与模型请到插件的 Provider 页配置。",
        "secret": true
      }
    }
  }
}
